source 'https://rubygems.org'

# You may use http://rbenv.org/ or https://rvm.io/ to install and use this version
ruby ">= 2.6.10"

# Exclude problematic versions of cocoapods and activesupport that causes build failures.
gem 'cocoapods', '>= 1.13', '!= 1.15.0', '!= 1.15.1'
gem 'activesupport', '>= 6.1.7.5', '!= 7.1.0'
gem 'xcodeproj', '< 1.26.0'
gem 'concurrent-ruby', '< 1.3.4'

# Ruby 3.4 removed these libraries from the standard library. Keep them as
# explicit dependencies only on Ruby versions that actually need them; the
# system Ruby shipped with older macOS versions already provides them and does
# not include headers for rebuilding their native extensions.
if Gem::Version.new(RUBY_VERSION) >= Gem::Version.new('3.4.0')
  gem 'bigdecimal'
  gem 'logger'
  gem 'benchmark'
  gem 'mutex_m'
  gem 'nkf'
end

# macOS' system Ruby 2.6 ships json 2.1.0 as a default gem. Reuse that build
# instead of trying to compile a newer json gem without Ruby development
# headers.
gem 'json', '2.1.0' if Gem::Version.new(RUBY_VERSION) < Gem::Version.new('2.7.0')
