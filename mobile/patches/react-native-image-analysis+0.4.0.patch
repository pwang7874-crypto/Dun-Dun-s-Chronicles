+  /**
+   * Offline person segmentation fallback used by outfit/selfie photos. The
+   * model is bundled in the APK, so it also covers first-run and devices where
+   * the Play-Services subject model is not installed yet.
+   */
+  private fun extractPerson(
+    context: Context,
+    bitmap: Bitmap,
+    options: SubjectOptions,
+    onSuccess: (WritableMap) -> Unit,
+    onFailure: (ImageAnalysisException) -> Unit,
+    sharedSettled: AtomicBoolean? = null,
+  ) {
+    if (!isSelfieCompiledIn) {
+      onFailure(ImageAnalysisException(ErrorCode.NO_SUBJECT, "No person was found."))
+      return
     }
+
+    val settled = sharedSettled ?: AtomicBoolean(false)
+    val selfieOptions =
+      SelfieSegmenterOptions.Builder()
+        .setDetectorMode(SelfieSegmenterOptions.SINGLE_IMAGE_MODE)
+        .build()
+    val selfie = Segmentation.getClient(selfieOptions)
+
+    selfie.process(InputImage.fromBitmap(bitmap, 0))
+      .addOnSuccessListener { result ->
+        selfie.close()
+        if (settled.get()) return@addOnSuccessListener
+        try {
+          val width = result.width
+          val height = result.height
+          val mask = result.buffer.duplicate().apply { rewind() }.asFloatBuffer()
+          if (width != bitmap.width || height != bitmap.height) {
+            if (settled.compareAndSet(false, true)) {
+              onFailure(
+                ImageAnalysisException(ErrorCode.NO_SUBJECT, "Person mask size was invalid."))
+            }
+            return@addOnSuccessListener
+          }
+
+          val pixels = IntArray(width * height)
+          bitmap.getPixels(pixels, 0, width, 0, 0, width, height)
+          var foregroundPixels = 0
+          for (index in pixels.indices) {
+            val confidence = if (mask.hasRemaining()) mask.get() else 0f
+            if (confidence >= 0.35f) foregroundPixels += 1
+            val alpha = (((confidence - 0.18f) / 0.64f) * 255f)
+              .toInt().coerceIn(0, 255)
+            pixels[index] = (alpha shl 24) or (pixels[index] and 0x00ffffff)
+          }
+          if (foregroundPixels < pixels.size / 200) {
+            if (settled.compareAndSet(false, true)) {
+              onFailure(ImageAnalysisException(ErrorCode.NO_SUBJECT, "No person was found."))
+            }
+            return@addOnSuccessListener
+          }
+
+          val foreground = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888)
+          foreground.setPixels(pixels, 0, width, 0, 0, width, height)
+          mask.rewind()
+          if (settled.compareAndSet(false, true)) {
+            onSuccess(assemble(context, foreground, mask, 1, options))
+          }
+        } catch (error: Exception) {
+          if (settled.compareAndSet(false, true)) {
+            onFailure(
+              ImageAnalysisException(
+                ErrorCode.UNKNOWN,
+                "Person cutout failed: ${error.message}"))
+          }
+        }
+      }
+      .addOnFailureListener { error ->
+        selfie.close()
+        if (settled.compareAndSet(false, true)) {
+          onFailure(
+            ImageAnalysisException(
+              ErrorCode.SUBJECT_UNAVAILABLE,
+              "Person segmentation failed: ${error.message}"))
+        }
+      }
