# development | test | production
DUNDUNJI_ENV=development
APP_PUBLIC_BASE_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///./data/dundunji.sqlite3

# 至少 32 字节；生产环境必须替换。不要提交真实值。
SESSION_SIGNING_SECRET=replace-with-at-least-32-random-characters
PHONE_HASH_SECRET=replace-with-an-independent-32-byte-secret

# 本地联调专用，生产环境必须为 false。
ALLOW_DEV_AUTH=false

# 火山方舟：模型 ID 从方舟控制台复制，不在客户端或仓库硬编码。
ARK_API_KEY=
ARK_MODEL_ID=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_TIMEOUT_SECONDS=90

# local 只允许开发/测试；生产环境使用 tos。
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_ENDPOINT=
TOS_REGION=
TOS_BUCKET=

# 火山短信：消息组、审核通过的签名/模板，以及最小发送权限的服务端凭据。
VOLC_SMS_ACCESS_KEY=
VOLC_SMS_SECRET_KEY=
VOLC_SMS_ACCOUNT=
VOLC_SMS_SIGN=
VOLC_SMS_TEMPLATE_ID=
VOLC_SMS_CODE_PARAM=code
VOLC_SMS_REGION=cn-north-1
VOLC_SMS_TIMEOUT_SECONDS=10

# 邀请码：独立的随机密钥（至少 32 字节），用于哈希存储邀请码。
INVITE_CODE_SECRET=replace-with-an-independent-32-byte-invite-secret
INVITE_DEFAULT_CREDITS=10
INVITE_VALIDITY_DAYS=90
